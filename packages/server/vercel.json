{
    "version": 2,
    "buildCommand": "pnpm install && pnpm build",
    "installCommand": "cd ../.. && pnpm install",
    "builds": [
        {
            "src": "dist/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "dist/index.js"
        }
    ]
}
