{
    "name": "seamlessai-lambda",
    "version": "1.0.0",
    "description": "AWS Lambda handler for SeamlessAI API",
    "main": "dist/index.js",
    "scripts": {
        "build": "pnpm install && pnpm run clean && pnpm run bundle && pnpm run package",
        "bundle": "tsc",
        "package": "rm -rf node_modules package-lock.json && pnpm install && pnpm prune --production && rm -f lambda.zip && cp -r node_modules dist/ && cd dist && zip -r ../lambda.zip . && cd ..",
        "dev": "tsc -w",
        "clean": "rm -rf dist lambda.zip"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.418.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.418.0",
        "@aws-sdk/client-dynamodb": "^3.418.0",
        "@aws-sdk/client-secrets-manager": "^3.418.0",
        "@aws-sdk/lib-dynamodb": "^3.418.0",
        "aws-lambda": "^1.0.7",
        "aws-sdk": "^2.1467.0",
        "jsonwebtoken": "^9.0.2",
        "jws": "^3.2.2",
        "lodash.includes": "^4.3.0",
        "lodash.isboolean": "^3.0.3",
        "lodash.isinteger": "^4.0.4",
        "lodash.isnumber": "^3.0.3",
        "lodash.isplainobject": "^4.0.6",
        "lodash.isstring": "^4.0.1",
        "lodash.once": "^4.0.0",
        "ms": "^2.1.1",
        "openai": "^4.0.0",
        "safe-buffer": "^5.2.1",
        "semver": "^7.5.4"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.119",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/node": "^20.0.0",
        "typescript": "^5.0.0",
        "vite": "^4.5.0"
    }
}
