        "@aws-sdk/client-secrets-manager": "^3.418.0",
        "@aws-sdk/client-bedrock-runtime": "^3.418.0",
        "@aws-sdk/lib-dynamodb": "^3.418.0",
        "jsonwebtoken": "^9.0.2",
        "uuid": "^9.0.0",
        "openai": "^4.0.0"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.119",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/uuid": "^9.0.2",
