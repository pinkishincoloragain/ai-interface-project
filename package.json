{
    "name": "ai-interface-project",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": ">=16.0.0",
        "pnpm": ">=7.0.0"
    },
    "scripts": {
        "dev:client": "pnpm --filter client dev",
        "dev:server": "pnpm --filter server dev",
        "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
        "build:client": "pnpm --filter client build",
        "build:server": "pnpm --filter server build",
        "build": "pnpm build:client && tsc",
        "deploy": "./deploy-terraform.sh",
        "deploy:cdk": "./deploy.sh",
        "test-openai": "pnpm --filter server test:openai",
        "lint": "eslint \"**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" && (cd terraform && terraform fmt)",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\" && (cd terraform && terraform fmt -check)",
        "format:terraform": "cd terraform && terraform fmt",
        "clean": "rimraf node_modules **/*/node_modules **/*/dist",
        "postinstall": "command -v husky >/dev/null 2>&1 && husky install || true",
        "prepare": "command -v husky >/dev/null 2>&1 && husky install || true"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^29.5.14",
        "@typescript-eslint/eslint-plugin": "^8.31.0",
        "@typescript-eslint/parser": "^8.31.0",
        "concurrently": "^8.2.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "husky": "^8.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^15.5.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.1",
        "ts-jest": "^29.3.2",
        "typescript": "^5.1.6"
    },
    "dependencies": {
        "@fastify/swagger": "^9.5.0",
        "@fastify/swagger-ui": "^5.2.2",
        "xstate": "^5.0.0"
    },
    "packageManager": "pnpm@8.15.4+sha1.c85a4305534f76d461407b59277b954bac97b5c4"
}
